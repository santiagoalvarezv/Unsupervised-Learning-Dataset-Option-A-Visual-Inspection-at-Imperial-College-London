# 6. Model B: GMM (PCA dimensionality reduction first)
# ============================================================
class GMMModel:
    def __init__(self, max_comp=3):
        self.max_comp = max_comp
        self.scaler = StandardScaler()
        self.pca = None
        self.model = None
        self.chosen = None

    def fit(self, X_raw):
        X = self.scaler.fit_transform(X_raw).astype(np.float64)
        n, d = X.shape
        safe_dim = max(8, min(d, n // 3, 128))
        if safe_dim < d:
            self.pca = PCA(n_components=safe_dim, svd_solver="full", random_state=CONFIG["seed"])
            X = self.pca.fit_transform(X)
            print(f"      [GMM] PCA reduced dimensions {d} → {X.shape[1]} (train_N={n})")

        # Select configuration with lowest BIC among various options
        best = None; best_bic = np.inf
        attempts = []
        for nc in range(1, self.max_comp + 1):
            for cov, reg in [("diag", 1e-3), ("full", 1e-2), ("tied", 1e-2)]:
                attempts.append((nc, cov, float(reg)))
        for nc, cov, reg in attempts:
            try:
                m = GaussianMixture(n_components=nc, covariance_type=cov,
                                    reg_covar=reg, random_state=CONFIG["seed"],
                                    max_iter=200, n_init=3, tol=1e-4)
                m.fit(X)
                bic = m.bic(X)
                if bic < best_bic:
                    best_bic = bic; best = (nc, cov, reg, m)
            except Exception:
                continue
        if best is None:
            raise RuntimeError("All GMM configurations failed")
        self.chosen = best[:3]; self.model = best[3]
        print(f"      [GMM] Optimal config n_comp={self.chosen[0]}, cov={self.chosen[1]}, reg={self.chosen[2]}, BIC={best_bic:.2f}")
        return self

    def score_samples(self, X_raw):
        X = self.scaler.transform(X_raw).astype(np.float64)
        if self.pca is not None: X = self.pca.transform(X)
        return (-self.model.score_samples(X)).astype(np.float64)  # Lower likelihood -> higher score

    def save(self, p): joblib.dump(self, p)

