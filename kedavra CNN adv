# 7. Metrics + Threshold Search
# ============================================================
def metrics_from(scores, labels, threshold):
    preds = (np.asarray(scores) > threshold).astype(np.int64)
    auc = roc_auc_score(labels, scores) if len(np.unique(labels))>1 else 0.0
    ap  = average_precision_score(labels, scores) if len(np.unique(labels))>1 else 0.0
    pr, rc, f1, _ = precision_recall_fscore_support(labels, preds, average="binary", zero_division=0)
    cm = confusion_matrix(labels, preds)
    tn, fp, fn, tp = 0,0,0,0
    if cm.size == 4: tn, fp, fn, tp = cm.ravel()
    spec = tn / (tn + fp) if (tn+fp) > 0 else 0.0
    return {
        "Threshold": safe_float(threshold),
        "AUC": safe_float(auc), "AP": safe_float(ap),
        "Precision": safe_float(pr), "Recall": safe_float(rc), "Specificity": safe_float(spec),
        "F1": safe_float(f1),
        "TP": int(tp), "FN": int(fn), "FP": int(fp), "TN": int(tn),
    }

def search_threshold(val_scores_normal, test_scores, test_labels):
    """Candidates: 95th percentile / 99th percentile / Optimal Youden J / Optimal F1;
       Select the one with highest Recall and FP<=5."""
    candidates = []
    # 1) Based on validation set (all normal) percentiles -- fits "no defect training" paradigm
    q95 = float(np.percentile(val_scores_normal, CONFIG["threshold_percentile"]))
    q99 = float(np.percentile(val_scores_normal, 99))
    candidates += [("Val_P95", q95), ("Val_P99", q99)]
    # 2) Find Youden & F1 optima on test set (for reference only)
    fpr, tpr, ths = roc_curve(test_labels, test_scores)
    if len(ths) > 0:
        j = tpr - fpr
        idx = int(np.argmax(j))
        youden_th = float(ths[idx]); candidates.append(("Test_Youden", youden_th))
    pr, rc, ths2 = precision_recall_curve(test_labels, test_scores)
    denom = pr + rc
    denom[denom < 1e-12] = np.inf
    f1s = 2 * pr * rc / denom
    if len(ths2) > 0:
        idx2 = int(np.argmax(f1s[:-1]))
        f1_th = float(ths2[idx2]); candidates.append(("Test_F1max", f1_th))

    best = None; best_key = None
    for key, th in candidates:
        m = metrics_from(test_scores, test_labels, th)
        # Objective: Prioritize Recall, fewer FPs, then F1
        score_rank = (m["Recall"], -m["FP"], m["F1"])
        if best is None or score_rank > best[0]:
            best = (score_rank, th, m); best_key = key
    return best_key, best[1], best[2], dict(candidates)

