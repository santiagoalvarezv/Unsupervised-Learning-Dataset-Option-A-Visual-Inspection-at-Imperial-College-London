def save_roc(all_scores, labels, out_path):
    """Figure 2: ROC Comparison"""
    fig, ax = plt.subplots(figsize=(9, 8))
    colors = {"ShallowAE": "#1976D2", "GMM": "#388E3C", "Ensemble": "#D32F2F"}
    for name, s in all_scores.items():
        fpr, tpr, _ = roc_curve(labels, s)
        auc = roc_auc_score(labels, s)
        ax.plot(fpr, tpr, color=colors.get(name, "#444"), lw=2.5,
                label=f"{name} (AUC = {auc:.4f})")
    ax.plot([0,1],[0,1],"k--", lw=1.5, alpha=0.6, label="Random Baseline (AUC=0.5)")
    ax.fill_between(fpr, tpr, alpha=0.08, color=colors.get(name))
    ax.set_xlabel("False Positive Rate (FPR)", fontsize=13); ax.set_ylabel("True Positive Rate (TPR = Recall)", fontsize=13)
    ax.set_title("ROC Curves — Three Methods Comparison", fontsize=CONFIG["fontsize_title"], fontweight="bold")
    ax.legend(fontsize=11, loc="lower right"); ax.grid(True, alpha=0.3)
    plt.tight_layout(); fig.savefig(out_path, dpi=160, bbox_inches="tight"); plt.close(fig)
