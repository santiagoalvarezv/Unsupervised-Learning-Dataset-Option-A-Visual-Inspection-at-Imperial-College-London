# 4. ResNet18 Feature Extraction + Patch-level Error (for Heatmaps)
# ============================================================
class FeatureExtractor:
    """Outputs both: global 512-dim GAP vector (for classifier) + layer feature maps (for localization heatmaps)"""
    def __init__(self, device):
        self.device = device
        self.net = models.resnet18(weights=models.ResNet18_Weights.IMAGENET1K_V1).to(device).eval()
        # Final vector (512-dim after GAP)
        self.gap_fc = nn.Sequential(
            nn.AdaptiveAvgPool2d(1), nn.Flatten(),
        )
        # Collect activations from layer2, layer3, layer4
        self.act = {}
        def _hook(name):
            def fn(mod, inp, out): self.act[name] = out.detach()
            return fn
        self.net.layer2.register_forward_hook(_hook("layer2"))
        self.net.layer3.register_forward_hook(_hook("layer3"))
        self.net.layer4.register_forward_hook(_hook("layer4"))

    @torch.no_grad()
    def __call__(self, batch_tensor):
        """batch_tensor (B,3,224,224) -> global_feat (B,512), feats_dict {'layer2': (B,C,H,W)...}"""
        self.act = {}
        self.net(batch_tensor.to(self.device))
        # GAP
        last = self.act["layer4"]
        g = self.gap_fc(last).cpu().numpy().astype(np.float64)
        fd = {k: v.cpu().numpy().astype(np.float64) for k, v in self.act.items()}
        return g, fd

def extract_global(paths, extractor, desc="Extracting features"):
    """Batch extract global features, returns (N, 512)"""
    outs = []
    batch = []
    for p in tqdm(paths, desc=desc, leave=False):
        img = Image.open(p).convert("RGB")
        batch.append(_TF(img))
        if len(batch) == CONFIG["batch_size"]:
            g, _ = extractor(torch.stack(batch))
            outs.append(g); batch = []
    if batch:
        g, _ = extractor(torch.stack(batch))
        outs.append(g)
    return np.vstack(outs).astype(np.float64)

