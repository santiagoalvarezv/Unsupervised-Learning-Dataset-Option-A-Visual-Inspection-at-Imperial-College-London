# 10. Main Pipeline
# ============================================================
def main():
    print("=" * 80)
    print("🏆 【Final Defense Version】 CNN ResNet18 + ShallowAE / GMM / Ensemble")
    print("=" * 80)
    print(f"💻 Device: {CONFIG['device']}  Category: {CONFIG['category']}  Size: {CONFIG['image_size']}  Seed: {CONFIG['seed']}")

    # ---- Data ----
    tr_paths, val_paths, test_paths, test_labels = load_data()

    # ---- Output Directory ----
    out_dir = Path(CONFIG["root_dir"]) / "final_defense_results"
    out_dir.mkdir(exist_ok=True)
    print(f"📁 Output Directory: {out_dir}")

    # ---- Global Feature Extraction ----
    print("\n🧠 Step 1: Extracting global 512-dim features using ResNet18...")
    ext = FeatureExtractor(CONFIG["device"])
    F_tr  = extract_global(tr_paths,  ext, "Training Features")
    F_val = extract_global(val_paths, ext, "Validation Features")
    F_te  = extract_global(test_paths, ext, "Test Features")
    print(f"   ✅ Complete: train {F_tr.shape}, val {F_val.shape}, test {F_te.shape}")

    # ---- Preprocessing (Remove zero-variance channels) ----
    std = F_tr.std(axis=0)
    keep = std > 1e-6
    if keep.sum() < F_tr.shape[1]:
        print(f"   ⚙️  Removing {F_tr.shape[1]-keep.sum()} zero-variance channels, keeping {keep.sum()} dims")
        F_tr, F_val, F_te = F_tr[:, keep], F_val[:, keep], F_te[:, keep]

    # ---- Model A: ShallowAE ----
    print("\n🤖 Step 2A: Training Shallow AE (Non-linear Reconstruction)...")
    ae = ShallowAE(CONFIG["device"], feature_dim=F_tr.shape[1],
                   latent_dim=CONFIG["ae_latent_dim"], lr=CONFIG["ae_lr"],
                   epochs=CONFIG["ae_epochs"], patience=CONFIG["ae_patience"]).fit(F_tr)
    s_ae_tr  = ae.score_samples(F_tr)
    s_ae_val = ae.score_samples(F_val)
    s_ae_te  = ae.score_samples(F_te)
    ae.save(out_dir / "shallow_ae.pth")

    # ---- Model B: GMM ----
    print("\n🤖 Step 2B: Training GMM (Generative Likelihood)...")
    gmm = GMMModel(max_comp=CONFIG["gmm_max_comp"]).fit(F_tr)
    s_gmm_val = gmm.score_samples(F_val)
    s_gmm_te  = gmm.score_samples(F_te)
    gmm.save(out_dir / "gmm.pkl")

    # ---- Ensemble ----
    print("\n⚖️  Step 3: Normalization + Weighted Ensemble...")
    w_ae, w_gmm = CONFIG["ensemble_weights"]
    print(f"   Weights = ShallowAE×{w_ae} + GMM×{w_gmm}")
    # Use train percentiles for min-max (avoids test data leakage, more stable)
    ref_ae, ref_gmm = s_ae_tr, gmm.score_samples(F_tr)
    def _norm(s, ref):
        lo, hi = np.percentile(ref, 1), np.percentile(ref, 99)
        if hi - lo < 1e-12: return np.zeros_like(s)
        return np.clip((s - lo) / (hi - lo), 0, None)
    n_ae_val, n_ae_te = _norm(s_ae_val, ref_ae), _norm(s_ae_te, ref_ae)
    n_gm_val, n_gm_te = _norm(s_gmm_val, ref_gmm), _norm(s_gmm_te, ref_gmm)
    ens_val = w_ae * n_ae_val + w_gmm * n_gm_val
    ens_te  = w_ae * n_ae_te  + w_gmm * n_gm_te

    all_scores = {
        "ShallowAE": s_ae_te,
        "GMM":       s_gmm_te,
        "Ensemble":  ens_te,
    }

    # ===================================================================
    # 【Anti-Cheating】Random shuffle test labels对照 experiment
    # Logic: Use the same scores, shuffle y_test, then recompute AUC/F1/Acc
    # - If model peeked at labels: metrics remain high after shuffling
    # - If model has zero leakage: AUC≈0.5, Acc≈random baseline after shuffling
    # ===================================================================
    labels_true = test_labels.copy()
    labels_shuf = None
    sanity_metrics = None
    # Compute all_metrics for true labels first (fix forward reference)
    _th_ae = float(np.percentile(s_ae_val, CONFIG["threshold_percentile"]))
    _th_gm = float(np.percentile(s_gmm_val, CONFIG["threshold_percentile"]))
    _true_metrics = {
        "ShallowAE": metrics_from(s_ae_te, labels_true, _th_ae),
        "GMM":       metrics_from(s_gmm_te, labels_true, _th_gm),
        "Ensemble":  None,   # Will be filled after threshold search
    }
    if CONFIG.get("sanity_check_shuffle_labels", False):
        rng_sf = np.random.default_rng(CONFIG["seed"] + 911)
        perm_sf = rng_sf.permutation(len(labels_true))
        labels_shuf = labels_true[perm_sf].copy()
        print("\n⚠️  【Anti-Cheating Experiment】Test labels randomly shuffled (seed=911), computing shuffled metrics...")
        chosen_key_sf, chosen_th_sf, ens_sf_metric, _ = search_threshold(ens_val, ens_te, labels_shuf)
        sanity_metrics = {
            "ShallowAE": metrics_from(s_ae_te, labels_shuf, _th_ae),
            "GMM":       metrics_from(s_gmm_te, labels_shuf, _th_gm),
            "Ensemble":  ens_sf_metric,
        }
        print("  ╔══════════════════════════════════════════════════════════════╗")
        print("  ║          【True Labels】 vs 【Randomly Shuffled Labels】     ║")
        print("  ╠══════════════════════════════════════════════════════════════╣")
        print("  ║ {:<11s}|{:>12s} | {:>12s} | {:>12s} |{:>12s}".format("Model", "True AUC", "Shuf AUC", "True F1", "Shuf F1"))
        print("  ╠══════════════════════════════════════════════════════════════╣")
        for k in ["ShallowAE","GMM"]:
            mT = _true_metrics[k]; mS = sanity_metrics[k]
            print("  ║ {:<11s}|{:>12.4f} | {:>12.4f} | {:>12.4f} |{:>12.4f}".format(
                k, mT["AUC"], mS["AUC"], mT["F1"], mS["F1"]))
        print("  ╠══════════════════════════════════════════════════════════════╣")
        print("  ║ Ensemble   |    (Will print final comparison after Step4 threshold search) ║")
        print("  ╚══════════════════════════════════════════════════════════════╝")

    # ---- Threshold Search ----
    print("\n🧮 Step 4: Automatic Threshold Search (Recall Priority)...")
    chosen_key, chosen_th, ens_metric, cand = search_threshold(ens_val, ens_te, labels_true)
    print(f"   Final Threshold Strategy: {chosen_key} = {chosen_th:.4g}")
    for k, v in cand.items():
        m = metrics_from(ens_te, labels_true, v)
        print(f"     - {k:<14s} th={v:>10.4g} → R={m['Recall']:.3f}  F1={m['F1']:.3f}  FP={m['FP']}")

    all_metrics = {
        "ShallowAE": metrics_from(s_ae_te, labels_true, _th_ae),
        "GMM":       metrics_from(s_gmm_te, labels_true, _th_gm),
        "Ensemble":  ens_metric,
    }
    _true_metrics["Ensemble"] = ens_metric
    print("\n✅ Final Metrics:")
    for n, m in all_metrics.items():
        print(f"   {n:<10s}  AUC={m['AUC']:.4f}  AP={m['AP']:.4f}  "
