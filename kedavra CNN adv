# 5. Model A: Shallow AE
# ============================================================
class ShallowAE:
    def __init__(self, device, feature_dim=512, latent_dim=64, lr=1e-3, epochs=120, patience=15):
        self.device, self.dim, self.ldim = device, feature_dim, latent_dim
        self.lr, self.epochs, self.patience = lr, epochs, patience
        self.scaler = StandardScaler()
        self.model = self._build()

    def _build(self):
        d, ld = self.dim, self.ldim
        return nn.Sequential(
            nn.Linear(d, 256), nn.BatchNorm1d(256), nn.ReLU(), nn.Dropout(0.1),
            nn.Linear(256, ld),
            nn.Linear(ld, 256), nn.BatchNorm1d(256), nn.ReLU(),
            nn.Linear(256, d),
        ).to(self.device)

    def fit(self, X_train_raw):
        X = self.scaler.fit_transform(X_train_raw).astype(np.float32)
        n = len(X)
        # Further split 9:1 as internal validation (for early stopping)
        n_va = max(3, int(n * 0.1))
        perm = np.random.default_rng(CONFIG["seed"]+1).permutation(n)
        va, tr = perm[:n_va], perm[n_va:]
        Xtr = torch.from_numpy(X[tr]); Xva = torch.from_numpy(X[va])

        opt = torch.optim.AdamW(self.model.parameters(), lr=self.lr, weight_decay=1e-4)
        sch = torch.optim.lr_scheduler.CosineAnnealingWarmRestarts(opt, T_0=10, eta_min=1e-5)
        crit = nn.MSELoss()
        best_loss = np.inf; best_state = None; bad = 0; self.log = {"tr":[], "va":[]}

        for ep in range(self.epochs):
            # Training
            self.model.train()
            perm2 = torch.randperm(len(Xtr))
            total = 0.0; cnt = 0
            for s in range(0, len(Xtr), 32):
                idx = perm2[s:s+32]
                bx = Xtr[idx].to(self.device)
                opt.zero_grad()
                loss = crit(self.model(bx), bx)
                loss.backward()
                torch.nn.utils.clip_grad_norm_(self.model.parameters(), 1.0)
                opt.step()
                total += loss.item()*len(idx); cnt += len(idx)
            self.log["tr"].append(total / max(cnt,1))
            sch.step()
            # Validation
            self.model.eval()
            with torch.no_grad():
                v = Xva.to(self.device)
                vloss = crit(self.model(v), v).item()
            self.log["va"].append(vloss)
            if vloss < best_loss - 1e-7:
                best_loss = vloss; best_state = {k:v.cpu().clone() for k,v in self.model.state_dict().items()}; bad = 0
            else:
                bad += 1
            if (ep+1) % 20 == 0:
                print(f"      [ShallowAE] Epoch {ep+1:>3}/{self.epochs}  "
                      f"tr={self.log['tr'][-1]:.5f}  va={vloss:.5f}  best={best_loss:.5f}  (patience {bad}/{self.patience})")
            if bad >= self.patience:
                print(f"      [ShallowAE] Early stopping @ Epoch {ep+1}, best va={best_loss:.5f}"); break
        self.model.load_state_dict(best_state)
        self.model.eval()
        return self

    def score_samples(self, X_raw):
        X = self.scaler.transform(X_raw).astype(np.float32)
        self.model.eval()
        with torch.no_grad():
            t = torch.from_numpy(X).to(self.device)
            rec = self.model(t).cpu().numpy()
        # Use per-dimension MSE (mean squared error) as anomaly score
        return np.mean((X - rec) ** 2, axis=1).astype(np.float64)

    def save(self, p):
        d = {"state": self.model.state_dict(), "scaler": self.scaler,
             "dim": self.dim, "ldim": self.ldim, "log": self.log}
        torch.save(d, p)

