          out_prefix.parent / f"{out_prefix.stem}_FP.png", "FP")
    _draw(idx_fn, "🟡 False Negative (FN) Analysis — Defects Missed by Model",
          out_prefix.parent / f"{out_prefix.stem}_FN.png", "FN")

