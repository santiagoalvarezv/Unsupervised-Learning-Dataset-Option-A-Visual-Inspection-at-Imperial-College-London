def load_data():
    root = Path(CONFIG["root_dir"]) / CONFIG["category"]
    def _scan(sub):
        p = root / sub
        return sorted([x for x in p.iterdir() if x.suffix.lower() in _IMG_EXT]) if p.exists() else []

    train_all = _scan("train/good")
    test_good = _scan("test/good")
    test_flaw = _scan("test/flaw")

    assert len(train_all) > 5,  "Too few normal images in training set (<5)"
    assert len(test_good) > 3,  "Too few normal images in test set (<3)"
    assert len(test_flaw) > 3,  "Too few defect images in test set (<3)"

    # Train / validation split (fixed seed for reproducibility)
    n = len(train_all)
    n_val = max(3, int(n * CONFIG["val_split_ratio"]))
    perm = np.random.default_rng(CONFIG["seed"]).permutation(n)
    val_idx, tr_idx = perm[:n_val], perm[n_val:]
    tr_paths  = [train_all[i] for i in tr_idx]
    val_paths = [train_all[i] for i in val_idx]

    test_paths  = test_good + test_flaw
    test_labels = np.array([0]*len(test_good) + [1]*len(test_flaw), dtype=np.int64)

    print(f"📂 Data loading complete [{CONFIG['category']}]")
    print(f"   Train (Normal): {len(tr_paths)}  |  Val (Normal, for threshold): {len(val_paths)}")
    print(f"   Test (Normal): {len(test_good)}  |  Test (Defect): {len(test_flaw)}  |  Total Test: {len(test_paths)}")
    return tr_paths, val_paths, test_paths, test_labels

