# 8. Defect Localization Heatmap (Based on "per-patch feature deviation", no training cost)
#    Idea: Compute Z-score between test image layer2/3/4 features and "training set mean±σ at same spatial locations",
#          fuse into a saliency map → upsample to original → overlay with jet colormap
# ============================================================
class PatchLocalizer:
    def __init__(self, extractor, device):
        self.ext = extractor
        self.device = device
        self.stats = {}  # layer -> (mean, std) shape (C, H, W)

    def fit(self, train_paths):
        """Compute mean and std for each spatial location across training set"""
        # Get layer shapes from first image
        g0, fd0 = self.ext(torch.stack([_TF(Image.open(train_paths[0]).convert("RGB"))]))
        layers = list(fd0.keys())
        sums  = {k: np.zeros_like(fd0[k][0]) for k in layers}      # C,H,W
        sq    = {k: np.zeros_like(fd0[k][0]) for k in layers}
        n = 0
        batch = []
        for p in tqdm(train_paths, desc="      Computing training patch statistics", leave=False):
            batch.append(_TF(Image.open(p).convert("RGB")))
            if len(batch) == CONFIG["batch_size"]:
                _, fd = self.ext(torch.stack(batch))
                for k in layers:
                    fs = fd[k]                # B,C,H,W
                    sums[k] += fs.sum(axis=0); sq[k] += (fs**2).sum(axis=0)
                n += len(batch); batch = []
        if batch:
            _, fd = self.ext(torch.stack(batch))
            for k in layers:
                fs = fd[k]
                sums[k] += fs.sum(axis=0); sq[k] += (fs**2).sum(axis=0)
            n += len(batch)
        for k in layers:
            mean = sums[k] / n
            var  = np.clip(sq[k]/n - mean*mean, 1e-6, None)
            self.stats[k] = (mean, np.sqrt(var))
        print(f"      [Localizer] Statistics computed for: {layers}")
        return self

    @torch.no_grad()
    def saliency(self, path, size=None):
        """Output H×W saliency map (0~1) + resized original image"""
        img_pil = Image.open(path).convert("RGB")
        sz = size or img_pil.size[::-1]  # (H,W)
        t = _TF(img_pil).unsqueeze(0)
        _, fd = self.ext(t)
        layers = list(fd.keys())
        maps = []
        for k in layers:
            f = fd[k][0]  # C,H,W
            mean, std = self.stats[k]
            z = np.abs(f - mean) / (std + 1e-9)   # C,H,W
            z = z.mean(axis=0)                      # H,W channel mean
            maps.append(z)
        # Multi-scale fusion: Upsample to largest resolution then weight
        H = max(m.shape[0] for m in maps)
        W = max(m.shape[1] for m in maps)
        fused = np.zeros((H, W), dtype=np.float64)
        for i, m in enumerate(maps):
            up = np.array(Image.fromarray(m).resize((W, H), Image.BILINEAR))
            fused += up * (i + 1)  # Deeper layers get higher weight
        fused /= sum(i+1 for i in range(len(maps)))
        # Normalize to 0~1
        fused = (fused - fused.min()) / max(1e-12, fused.max() - fused.min())
        # Resize to original image size
        sal = np.array(Image.fromarray(fused).resize((sz[1], sz[0]), Image.BILINEAR))
        img = np.array(img_pil.resize((sz[1], sz[0])))
        return sal, img

