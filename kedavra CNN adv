    pos = labels.mean()
    ax.axhline(pos, color="#888", ls=":", lw=2, label=f"Random Baseline (AP={pos:.3f})")
    for name, s in all_scores.items():
        p, r, _ = precision_recall_curve(labels, s)
        ap = average_precision_score(labels, s)
        # Break-even point (P=R)
        bep = float(p[np.argmin(np.abs(p - r))])
        ax.plot(r, p, color=colors.get(name, "#444"), lw=2.5,
                label=f"{name} (AP={ap:.4f}, BEP={bep:.4f})")
    ax.set_xlabel("Recall", fontsize=13); ax.set_ylabel("Precision", fontsize=13)
    ax.set_title("Precision-Recall Curves Comparison (PR focuses on defect positives)", fontsize=CONFIG["fontsize_title"], fontweight="bold")
    ax.set_xlim(-0.02, 1.02); ax.set_ylim(-0.02, 1.05)
    ax.legend(fontsize=11, loc="lower left"); ax.grid(True, alpha=0.3)
    plt.tight_layout(); fig.savefig(out_path, dpi=160, bbox_inches="tight"); plt.close(fig)
    print(f"  ✅ PR Comparison → {out_path.name}")

